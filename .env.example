# Supabase Dashboard -> Connect -> URI (use the Session Pooler URI for Vercel)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@[pooler-host]:5432/postgres

# Supabase Auth, only needed if using Supabase Auth in addition to Clerk
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Create a Clerk application, enable Google under User & Authentication > Social connections,
# then paste the publishable key here. Keep the secret key server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here